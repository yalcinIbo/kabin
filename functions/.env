# Kabin Functions parametreleri (deploy'da okunur). Gizli anahtarlar burada DEĞİL:
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set HF_TOKEN   (isteğe bağlı, yoksa 'unset')
#   firebase functions:secrets:set FAL_KEY    (isteğe bağlı, yoksa 'unset')
# Varsayılan ücretsiz yol fal.ai gerektirmez.
# gemini | fashn | vertex | both
TRYON_PROVIDER=gemini
# trellis2 (ücretsiz, Hugging Face, önerilen) | trellis (eski, daha düşük kalite) | hunyuan | tripo (fal.ai)
MODEL3D_PROVIDER=trellis2
# gemini | birefnet (fal.ai)
SEGMENTATION_PROVIDER=gemini
VERTEX_LOCATION=us-central1
VERTEX_TRYON_MODEL=virtual-try-on-001
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
STORAGE_BUCKET=kabin-app-2026.firebasestorage.app
# none | all | virgülle ayrılmış liste: tryon,segmentation,imagegen,model3d,vision
MOCK_PROVIDERS=none
